<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="SmashZone.SiteMaster" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%: Page.Title %> - SmashZone Sports</title>

    <asp:PlaceHolder runat="server">
        <%: Scripts.Render("~/bundles/modernizr") %>
    </asp:PlaceHolder>

    <webopt:BundleReference runat="server" Path="~/Content/css" />

    <link href="~/favicon.ico" rel="shortcut icon" type="image/x-icon" />

    <!-- Bootstrap 5.3 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet"
          integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
          crossorigin="anonymous" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <style>
    /* keep navbar height consistent */
    .navbar {
        padding-top: .7rem;
        padding-bottom: .7rem;
    }

    /* make all nav links same height and vertically centered */
    .navbar .nav-link {
        padding-top: .25rem;
        padding-bottom: .25rem;
        line-height: 1;
        display: flex;
        align-items: center;
    }

    /* dropdown caret can push height a bit; keep it centered */
    .navbar .dropdown-toggle::after {
        margin-left: .35rem;
        align-self: center;
    }

    /* ================= MEGA MENU ================= */
.mega-dropdown .dropdown-menu {
    width: min(950px, 96vw);
    padding: 22px 22px;
    border-radius: 14px;
    border: 1px solid rgba(0,0,0,.08);
    box-shadow: 0 18px 40px rgba(0,0,0,.15);
}

.mega-title {
    font-weight: 800;
    letter-spacing: .02em;
    margin-bottom: 10px;
    text-transform: uppercase;
    font-size: .95rem;
}

.mega-link {
    display: block;
    padding: 8px 0;
    color: #111;
    text-decoration: none;
}

.mega-link:hover { text-decoration: underline; }

.mega-col + .mega-col { border-left: 1px solid rgba(0,0,0,.08); }

@media (max-width: 991px) {
    .mega-dropdown .dropdown-menu { width: 100%; padding: 12px; }
    .mega-col + .mega-col {
        border-left: none;
        border-top: 1px solid rgba(0,0,0,.08);
        margin-top: 12px;
        padding-top: 12px;
    }
}

/* OPTIONAL: hover open on desktop only */
@media (min-width: 992px) {
    .mega-dropdown:hover .dropdown-menu { display: block; }
    .mega-dropdown:hover > .dropdown-toggle { color: #fff; }
}

</style>

    <asp:ContentPlaceHolder ID="head" runat="server"></asp:ContentPlaceHolder>

</head>

<body>
<form runat="server">

    <!-- ScriptManager (keep for WebForms only) -->
    <asp:ScriptManager runat="server">
        <Scripts>
            <asp:ScriptReference Name="MsAjaxBundle" />
            <asp:ScriptReference Name="jquery" />
            <asp:ScriptReference Name="WebFormsBundle" />
        </Scripts>
    </asp:ScriptManager>

    <!-- NAVBAR -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">

            <a class="navbar-brand" runat="server" href="~/Pages/User/Default.aspx">SmashZone Sports</a>

            <button class="navbar-toggler" type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#navbarSupportedContent"
                    aria-controls="navbarSupportedContent"
                    aria-expanded="false"
                    aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarSupportedContent">

                <!-- LEFT SIDE LINKS -->
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">

    <!-- ✅ MEGA MENU -->
    <li class="nav-item dropdown mega-dropdown">
        <a class="nav-link dropdown-toggle"
           href="#"
           id="shopDropdown"
           role="button"
           data-bs-toggle="dropdown"
           aria-expanded="false">
            Shop
        </a>

        <div class="dropdown-menu" aria-labelledby="shopDropdown">
            <div class="row g-0">

                <!-- SPORTS -->
                <div class="col-lg-4 mega-col px-lg-3">
                    <div class="mega-title">Sports</div>
                    <a class="mega-link" runat="server" href="~/Pages/User/badmintonProducts.aspx">Badminton</a>
                    <a class="mega-link" runat="server" href="~/Pages/User/tennisProducts.aspx">Tennis</a>
                    <a class="mega-link" runat="server" href="~/Pages/User/squashProducts.aspx">Squash</a>
                </div>

                <!-- SHOES -->
                <div class="col-lg-4 mega-col px-lg-3">
                    <div class="mega-title">Shoes</div>
                    <a class="mega-link" runat="server" href="~/Pages/User/badmintonProducts.aspx?category=Shoes">Badminton Shoes</a>
                    <a class="mega-link" runat="server" href="~/Pages/User/tennisProducts.aspx?category=Shoes">Tennis Shoes</a>
                    <a class="mega-link" runat="server" href="~/Pages/User/squashProducts.aspx?category=Shoes">Squash Shoes</a>
                </div>

                <!-- RACQUET -->
                <div class="col-lg-4 mega-col px-lg-3">
                    <div class="mega-title">Racquet</div>
                    <a class="mega-link" runat="server" href="~/Pages/User/badmintonProducts.aspx?category=Rackets">Badminton Racquets</a>
                    <a class="mega-link" runat="server" href="~/Pages/User/tennisProducts.aspx?category=Rackets">Tennis Racquets</a>
                    <a class="mega-link" runat="server" href="~/Pages/User/squashProducts.aspx?category=Rackets">Squash Racquets</a>
                </div>

            </div>
        </div>
    </li>


    <!-- ABOUT -->
    <li class="nav-item dropdown">
        <a class="nav-link dropdown-toggle"
           href="#"
           id="aboutDropdown"
           role="button"
           data-bs-toggle="dropdown"
           aria-expanded="false">
            About Us
        </a>
        <ul class="dropdown-menu" aria-labelledby="aboutDropdown">
            <li><a class="dropdown-item" href="/Pages/User/About.aspx">About Us</a></li>
            <li><a class="dropdown-item" runat="server" href="~/Pages/User/Faq.aspx">FAQs</a></li>
            <li><hr class="dropdown-divider" /></li>
            <li><a class="dropdown-item" href="#">Something else here</a></li>
        </ul>
    </li>

    <li class="nav-item">
        <a class="nav-link" runat="server" href="~/Pages/User/Contact.aspx">Contact</a>
    </li>

    <!-- ✅ KEEP ADMIN DROPDOWN -->
    <li class="nav-item dropdown">
        <a class="nav-link dropdown-toggle"
           href="#"
           id="manageDropdown"
           role="button"
           data-bs-toggle="dropdown"
           aria-expanded="false">
            Admin
        </a>

        <ul class="dropdown-menu" aria-labelledby="manageDropdown">
            <li>
                <a class="dropdown-item" runat="server" href="~/Pages/Admin/dashboard.aspx">Dashboard</a>
            </li>
            <li>
                <a class="dropdown-item" runat="server" href="~/Pages/Admin/manageProducts.aspx">Manage Products</a>
            </li>
            <li>
                <a class="dropdown-item" runat="server" href="~/Pages/Admin/addProducts.aspx">Add Products</a>
            </li>
        </ul>
    </li>

</ul>


                <!-- SEARCH BAR -->
                <div class="d-flex me-3" role="search">
                    <input class="form-control me-2" type="search" placeholder="Search" aria-label="Search" />
                    <button class="btn btn-outline-success" type="button">
                        <i class="bi bi-search"></i>
                    </button>
                </div>

                <!-- RIGHT SIDE ICONS -->
                <ul class="navbar-nav mb-0 align-items-center">

                    <!-- PERSON ICON DROPDOWN -->
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle text-light d-flex align-items-center"
                           href="#"
                           id="userDropdown"
                           role="button"
                           data-bs-toggle="dropdown"
                           aria-expanded="false">
                            <i class="bi bi-person fs-2"></i>
                        </a>

                        <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
                            <li><a class="dropdown-item" runat="server" href="~/Pages/User/Login.aspx">Sign Out</a></li>
                            <li><a class="dropdown-item" runat="server" href="~/Pages/User/accountDetails.aspx">Account Details</a></li>
                        </ul>
                    </li>

                    <!-- CART ICON -->
                    <li class="nav-item">
                        <a class="nav-link text-light d-flex align-items-center"
                           runat="server" href="~/Pages/User/Cart.aspx">
                            <i class="bi bi-cart fs-3"></i>
                        </a>
                    </li>

                </ul>

            </div>
        </div>
    </nav>


    <div class="container body-content">
        <asp:ContentPlaceHolder ID="MainContent" runat="server"></asp:ContentPlaceHolder>

        <hr />
        <footer>
            <p>&copy; <%: DateTime.Now.Year %> - SmashZone Sports Singapore</p>
        </footer>
    </div>

</form>

<!-- Bootstrap 5 JS (REQUIRED for dropdown + toggle) -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
        crossorigin="anonymous"></script>
</body>
</html>
