<%@ Page Title="About" Language="C#" MasterPageFile="~/Master_Pages/Site.Master" AutoEventWireup="true"
    CodeBehind="About.aspx.cs" Inherits="SmashZone.About" %>

<asp:Content ID="BodyContent" ContentPlaceHolderID="MainContent" runat="server">
    <main class="container py-4" aria-labelledby="title">
        <h2 id="title" class="fw-bold mb-3">About SmashZone Sports</h2>

        <p>
            SmashZone Sports is a Singapore-based sports retailer dedicated to providing
            high-quality equipment for badminton, tennis, and squash enthusiasts.
            We aim to make sports accessible to everyone — from beginners to competitive players.
        </p>

        <p>
            Our mission is to deliver reliable products, fair pricing, and a smooth online
            shopping experience. Every item we carry is carefully selected to ensure
            performance, durability, and value.
        </p>

        <p>
            At SmashZone Sports, we believe that staying active builds confidence,
            discipline, and a healthier lifestyle. We are proud to support Singapore’s
            growing sports community and help players perform at their best.
        </p>
    </main>
</asp:Content>
